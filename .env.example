POSTGRES_DB=librigest
POSTGRES_USER=librigest
POSTGRES_PASSWORD=librigest
# Cambia SECRET_KEY en produccion (firma las cookies de sesion)
SECRET_KEY=change-me-please

# Parametros de negocio (opcionales; se pasan al servicio web, ver app/config.py)
# Tipo de cambio USD -> MXN para valor de reposicion y compras
TIPO_CAMBIO_USD_MXN=18.00
# Presupuesto mensual de adquisiciones (USD)
PRESUPUESTO_MENSUAL_USD=5000
# Dias habiles que se aparta un libro para quien esta primero en la lista de espera
ESPERA_DIAS_APARTADO=2

# Seguridad (PS-S4-03 / PS-NFR-05, ver docs/operacion.md)
# true (demo): la API de recuperacion de contrasena devuelve el codigo en pantalla. En produccion usa false:
# la API solo responde ok y el codigo queda como correo simulado en Notificaciones.
DEMO_MOSTRAR_TOKEN=true
# true cuando un proxy inverso termina TLS: la cookie de sesion se marca Secure
HTTPS=false
